{
	"name": "omen",
	"version": "1.0.0",
	"private": true,
	"main": "dist/index.js",
	"scripts": {
		"server:dev": "tsx watch src/index.ts",
		"server:build": "rm -rf dist && tsc && cp -r src/client dist/client",
		"start": "node dist/index.js",
		"dev": "node proxy.js",
		"build": "npm install --prefix client && npm run build --prefix client && rm -rf src/client && cp -r client/dist src/client && npm run server:build"
	},
	"engines": {
		"node": ">=22.12"
	},
	"author": "Eissa Saber",
	"license": "MIT",
	"dependencies": {
		"cors": "^2.8.6",
		"dotenv": "^18.0.8",
		"express": "^5.3.0",
		"mongoose": "^9.11.2"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
